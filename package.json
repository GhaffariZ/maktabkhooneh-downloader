{
  "name": "maktabkhooneh-study-library",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Persian-first local study library for Maktabkhooneh courses, with streaming, selective downloads, and progress tracking",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:server": "tsx server/main.ts",
    "dev:server": "tsx watch server/main.ts --dev",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "build:client": "vite build && node scripts/copy-licenses.mjs",
    "test": "node --import tsx --test tests/backend/**/*.test.ts tests/frontend/**/*.test.ts",
    "test:backend": "node --import tsx --test tests/backend/**/*.test.ts",
    "test:frontend": "node --import tsx --test tests/frontend/**/*.test.ts"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.1.1",
    "@videojs/react": "^10.4.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
